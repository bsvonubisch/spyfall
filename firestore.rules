rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.get('email', '') == 'owner@example.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.get('identities', {}).keys().hasAny(['google.com']);
    }
    function uid() { return request.auth.uid; }
    function room(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function after(code) { return getAfter(/databases/$(database)/documents/rooms/$(code)).data; }
    function member(r) { return signedIn() && uid() in r.memberIds; }
    function host(r) { return signedIn() && r.hostId == uid(); }
    function fresh(r) { return request.time < r.createdAt + duration.value(24, 'h'); }
    function caught(r) { return r.get('caughtIds', []); }
    function activeIds(r) { return r.memberIds.removeAll(caught(r)); }
    function spies(s) { return s.get('spyIds', [s.get('spyId', '')]); }
    function spyCount(r) { return r.settings.get('spies', 1); }
    function archived(r) { return r.status != 'ended' || !('roundKey' in r) || exists(/databases/$(database)/documents/results/$(r.roundKey)); }
    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function validAvatar(s, id) { return s.get('avatarSeed',id) is string && s.get('avatarSeed',id).size() >= 1 && s.get('avatarSeed',id).size() <= 64; }
    function validPhoto(s) {
      let url = s.get('avatarUrl', '');
      return url is string && (url == '' || url.size() <= 2048 && url.matches('^https://[a-zA-Z0-9-]+[.]googleusercontent[.]com/[^<>" ]+$'));
    }
    function validStats(s, id) {
      return s.keys().hasOnly(['id','name','avatarSeed','avatarUrl','wins','gamesPlayed','lastRoundKey','updatedAt']) && s.id == id && validName(s.name) && validAvatar(s,id) && validPhoto(s)
        && s.wins is int && s.gamesPlayed is int && s.wins >= 0 && s.gamesPlayed >= s.wins
        && s.lastRoundKey is string && s.updatedAt == request.time;
    }
    match /usage/{eventId} {
      allow get: if admin() || signedIn() && resource.data.uid == uid();
      allow list: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['type','uid','sessionId','screen','roomCode','roundId','device','source','createdAt'])
        && request.resource.data.uid == uid() && request.resource.data.source == 'client'
        && request.resource.data.createdAt == request.time
        && request.resource.data.sessionId is string && request.resource.data.sessionId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.screen in ['home','lobby','round','result','loading']
        && request.resource.data.device in ['mobile','desktop']
        && request.resource.data.roomCode is string && request.resource.data.roomCode.matches('^([A-Z2-9]{6})?$')
        && request.resource.data.roundId is int && request.resource.data.roundId >= 0
        && request.resource.data.type in ['visit','screen_view','room_created','room_joined','round_started','vote_cast','guess_submitted','round_ended','round_cancelled','room_left','rules_saved','profile_saved','google_signin','invite_copied','role_revealed','question_idea','leaderboard_opened','location_set'];
    }
    match /presence/{session} {
      allow get: if admin() || signedIn() && resource.data.uid == uid();
      allow list: if admin();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','sessionId','roomCode','screen','active','updatedAt'])
        && request.resource.data.uid == uid()
        && request.resource.data.sessionId.matches('^[a-f0-9-]{36}$')
        && session == request.resource.data.sessionId + '_' + uid()
        && request.resource.data.screen in ['home','lobby','round','result','loading']
        && request.resource.data.active is bool && request.resource.data.updatedAt == request.time
        && request.resource.data.roomCode.matches('^([A-Z2-9]{6})?$')
        && (!request.resource.data.active || request.resource.data.roomCode == '' || member(room(request.resource.data.roomCode)));
    }
    function awardAllowed(key, id) {
      let result = get(/databases/$(database)/documents/results/$(key)).data;
      let award = getAfter(/databases/$(database)/documents/results/$(key)/awards/$(id)).data;
      return signedIn() && uid() in result.memberIds && id in result.memberIds
        && !exists(/databases/$(database)/documents/results/$(key)/awards/$(id))
        && award == {'won':id in result.winnerIds,'createdAt':request.time};
    }
    function statsIncrement(old, next, id) {
      let result = get(/databases/$(database)/documents/results/$(next.lastRoundKey)).data;
      return validStats(next,id) && awardAllowed(next.lastRoundKey,id)
        && next.gamesPlayed == old.get('gamesPlayed',0) + 1
        && next.wins == old.get('wins',0) + (id in result.winnerIds ? 1 : 0);
    }
    match /profiles/{id} {
      match /preferences/{key} {
        allow get: if signedIn() && uid() == id;
        allow create, update: if signedIn() && uid() == id && key == 'game'
          && request.resource.data.keys().hasOnly(['locations', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && validSettings({'minutes':8, 'voting':'majority', 'spies':1, 'locations':request.resource.data.locations});
        allow create, update: if signedIn() && uid() == id && key == 'identity'
          && request.resource.data.keys().hasOnly(['googleProfileApplied', 'updatedAt'])
          && request.resource.data.googleProfileApplied == true
          && request.resource.data.updatedAt == request.time
          && request.auth.token.firebase.get('identities', {}).keys().hasAny(['google.com']);
      }
      allow get: if signedIn();
      allow list: if admin() || signedIn() && request.query.limit <= 50;
      allow create: if signedIn() && validStats(request.resource.data,id) && (
        uid() == id && request.resource.data.wins == 0 && request.resource.data.gamesPlayed == 0 && request.resource.data.lastRoundKey == ''
        || statsIncrement({},request.resource.data,id) && request.resource.data.name == get(/databases/$(database)/documents/results/$(request.resource.data.lastRoundKey)).data.players[id].name
          && request.resource.data.get('avatarSeed',id) == get(/databases/$(database)/documents/results/$(request.resource.data.lastRoundKey)).data.players[id].get('avatarSeed',id)
          && request.resource.data.get('avatarUrl','') == get(/databases/$(database)/documents/results/$(request.resource.data.lastRoundKey)).data.players[id].get('avatarUrl',''));
      allow update: if signedIn() && validStats(request.resource.data,id) && (
        uid() == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatarSeed','avatarUrl','updatedAt'])
        || request.resource.data.name == resource.data.name && request.resource.data.get('avatarSeed',id) == resource.data.get('avatarSeed',id)
          && request.resource.data.get('avatarUrl','') == resource.data.get('avatarUrl','') && statsIncrement(resource.data,request.resource.data,id));
    }
    match /results/{key} {
      allow get: if signedIn();
      allow list: if admin();
      function validResult() {
        let next = request.resource.data;
        let r = room(next.code);
        let s = get(/databases/$(database)/documents/rooms/$(next.code)/secrets/current).data;
        let spyWins = r.result.reason in ['timeout','host'] || (r.result.reason == 'guess' ? r.result.guess == s.location : !(r.result.accusedId in spies(s)));
        return member(r) && r.status == 'ended' && r.roundKey == key
          && next.keys().hasOnly(['code','roundId','memberIds','players','winnerIds','completedAt'])
          && next.roundId == r.roundId && next.memberIds == r.memberIds && next.players == r.players
          && next.winnerIds == (spyWins ? spies(s) : r.memberIds.removeAll(spies(s))) && next.completedAt == request.time;
      }
      allow create: if signedIn() && validResult();
      match /awards/{id} {
        allow get: if signedIn();
        allow create: if awardAllowed(key,id)
          && getAfter(/databases/$(database)/documents/profiles/$(id)).data.lastRoundKey == key
          && getAfter(/databases/$(database)/documents/rooms/$(get(/databases/$(database)/documents/results/$(key)).data.code)/scores/$(id)).data.lastRoundKey == key;
      }
    }
    function clearingRound(code) {
      let old = room(code);
      return old.status in ['active','accusing','ended'] && (host(old) || (member(old) && !(uid() in after(code).memberIds)))
        && (!existsAfter(/databases/$(database)/documents/rooms/$(code)) || after(code).status == 'lobby');
    }
    function validSettings(s) {
      return s.keys().hasOnly(['minutes', 'voting', 'spies', 'locations'])
        && s.minutes is int && s.minutes >= 2 && s.minutes <= 20
        && s.voting in ['majority', 'unanimous']
        && s.get('spies', 1) is int && s.get('spies', 1) >= 1 && s.get('spies', 1) <= 3
        && s.locations is list && s.locations.size() >= 3 && s.locations.size() <= 40
        && s.locations.toSet().size() == s.locations.size();
    }

    function voteAt(r, i, target) { return r.memberIds.size() > i && r.votes.get(r.memberIds[i], '') == target ? 1 : 0; }
    function count(r, target) {
      return voteAt(r,0,target) + voteAt(r,1,target) + voteAt(r,2,target) + voteAt(r,3,target)
        + voteAt(r,4,target) + voteAt(r,5,target) + voteAt(r,6,target) + voteAt(r,7,target)
        + voteAt(r,8,target) + voteAt(r,9,target) + voteAt(r,10,target) + voteAt(r,11,target)
        + voteAt(r,12,target) + voteAt(r,13,target) + voteAt(r,14,target);
    }
    function passed(r, target) {
      let n = activeIds(r).size();
      return n == 2 ? count(r,target) >= 1 : r.settings.voting == 'unanimous' ? count(r,target) >= n - 1 : count(r,target) > n / 2;
    }
    match /rooms/{code} {
      // Only the verified Google owner can query rooms for the admin overview.
      allow get: if signedIn();
      allow list: if admin();
      allow create: if signedIn() && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['hostId','memberIds','players','status','settings','roundId','votes','createdAt'])
        && request.resource.data.hostId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.players.keys().hasOnly([uid()])
        && validPlayer(request.resource.data.players[uid()])
        && request.resource.data.status == 'lobby' && request.resource.data.roundId == 0
        && request.resource.data.votes == {} && request.resource.data.createdAt == request.time
        && validSettings(request.resource.data.settings);
      function validPlayer(p) { return p.keys().hasOnly(['id','name','avatarSeed','avatarUrl']) && p.id == uid() && validName(p.name) && validAvatar(p,uid()) && validPhoto(p); }
      function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
      function cleared() {
        let next = request.resource.data;
        return next.status == 'lobby' && next.votes == {} && caught(next) == [] && next.result == null && !('startedAt' in next);
      }
      function join() {
        let old = resource.data; let next = request.resource.data;
        return old.status == 'lobby' && !(uid() in old.memberIds) && old.memberIds.size() < 15
          && changed(['memberIds','players']) && next.memberIds == old.memberIds.concat([uid()])
          && next.players.diff(old.players).affectedKeys().hasOnly([uid()]) && validPlayer(next.players[uid()]);
      }
      function rename() {
        let old = resource.data; let next = request.resource.data;
        return old.status == 'lobby' && changed(['players'])
          && next.players.diff(old.players).affectedKeys().hasOnly([uid()]) && validPlayer(next.players[uid()]);
      }
      function remove() {
        let old = resource.data; let next = request.resource.data;
        let removed = old.memberIds.removeAll(next.memberIds);
        return archived(old) && (old.status == 'lobby' ? changed(['memberIds','players','hostId'])
          : removed.size() == 1 && removed[0] == uid() && changed(['memberIds','players','hostId','status','votes','caughtIds','result','startedAt']) && cleared())
          && removed.size() == 1 && next.memberIds == old.memberIds.removeAll(removed) && next.memberIds.size() >= 1
          && (host(old) || removed[0] == uid())
          && next.players.diff(old.players).affectedKeys().hasOnly(removed)
          && next.players.keys().toSet() == next.memberIds.toSet()
          && next.hostId == (old.hostId == removed[0] ? next.memberIds[0] : old.hostId);
      }
      function start() {
        let old = resource.data; let next = request.resource.data;
        let secret = getAfter(/databases/$(database)/documents/rooms/$(code)/secrets/current).data;
        return host(old) && old.status == 'lobby' && old.memberIds.size() >= 2
          && (spyCount(old) == 1 || old.memberIds.size() >= spyCount(old) * 4)
          && changed(['status','roundId','roundKey','startedAt','votes','caughtIds','result'])
          && next.roundKey is string && next.roundKey.matches('^[a-f0-9-]{36}$')
          && !exists(/databases/$(database)/documents/results/$(next.roundKey))
          && next.status == 'active' && next.roundId == old.roundId + 1 && next.startedAt == request.time
          && next.votes == {} && caught(next) == [] && next.result == null && secret.roundId == next.roundId;
      }
      function vote() {
        let old = resource.data; let next = request.resource.data; let target = next.votes[uid()];
        return old.status == 'active' && changed(['votes','status','result'])
          && uid() in activeIds(old) && target in activeIds(old) && target != uid()
          && next.votes.diff(old.votes).affectedKeys().hasOnly([uid()])
          && (passed(next,target)
            ? (next.status == 'accusing' || (spyCount(old) == 1 && next.status == 'ended')) && next.result == {'reason':'vote','accusedId':target}
            : next.status == 'active' && next.result == old.result);
      }
      function resolveVote() {
        let old = resource.data; let next = request.resource.data;
        let target = old.result.accusedId;
        let isSpy = get(/databases/$(database)/documents/rooms/$(code)/roles/$(target)).data.isSpy;
        return old.status == 'accusing'
          && (isSpy && caught(old).size() + 1 < spyCount(old)
            ? changed(['status','votes','caughtIds','result']) && next.status == 'active'
              && caught(next) == caught(old).concat([target]) && next.votes == {} && next.result == null
            : changed(['status']) && next.status == 'ended');
      }
      function finish() {
        let old = resource.data; let next = request.resource.data;
        return old.status in ['active','accusing'] && changed(['status','result']) && next.status == 'ended'
          && (host(old) && next.result == {'reason':'host'} || old.status == 'active' && uid() in activeIds(old)
              && get(/databases/$(database)/documents/rooms/$(code)/roles/$(request.auth.uid)).data.isSpy == true
              && next.result.keys().hasOnly(['reason','guess','guesserId']) && next.result.get('guesserId', uid()) == uid()
              && next.result.reason == 'guess' && next.result.guess in old.settings.locations);
      }
      function resetRound() {
        return host(resource.data) && archived(resource.data)
          && changed(['status','votes','caughtIds','result','startedAt']) && cleared();
      }
      function lobbyChange() {
        return join() || member(resource.data) && (remove() || rename()
          || host(resource.data) && (changed(['settings']) && validSettings(request.resource.data.settings) || start()));
      }
      function roundChange() {
        let old = resource.data; let next = request.resource.data;
        return member(old) && (next.status == 'lobby' ? remove() || resetRound()
          : old.status == 'active' ? (next.status in ['active','accusing'] || next.status == 'ended' && next.result.reason == 'vote' ? vote() : finish())
          : old.status == 'accusing' && (resolveVote() || finish()));
      }
      allow update: if signedIn() && fresh(resource.data)
        && (resource.data.status == 'lobby' ? lobbyChange() : roundChange());
      allow delete: if host(resource.data) && resource.data.memberIds == [uid()] && archived(resource.data);
      match /scores/{id} {
        allow get: if signedIn();
        allow list: if member(room(code)) && request.query.limit <= 50;
        function validScore(old) {
          let next = request.resource.data;
          let result = get(/databases/$(database)/documents/results/$(next.lastRoundKey)).data;
          return result.code == code && next.name == result.players[id].name && next.get('avatarSeed',id) == result.players[id].get('avatarSeed',id)
            && next.get('avatarUrl','') == result.players[id].get('avatarUrl','') && statsIncrement(old,next,id);
        }
        allow create: if validScore({});
        allow update: if validScore(resource.data);
      }
      match /secrets/{id} {
        allow get: if member(room(code)) && room(code).status == 'ended';
        allow list: if false;
        allow create, update: if id == 'current' && host(room(code)) && room(code).status == 'lobby'
          && after(code).status == 'active' && request.resource.data.keys().hasOnly(['spyId','spyIds','location','roundId'])
          && request.resource.data.roundId == after(code).roundId
          && spies(request.resource.data) is list && spies(request.resource.data).size() == spyCount(room(code))
          && spies(request.resource.data).toSet().size() == spies(request.resource.data).size()
          && room(code).memberIds.hasAll(spies(request.resource.data))
          && request.resource.data.location in room(code).settings.locations;
        allow delete: if clearingRound(code);
      }
      match /roles/{id} {
        // Own-role listeners may observe the deletion when a round stops.
        allow get: if member(room(code)) && (uid() == id
          || room(code).status == 'accusing' && room(code).result.accusedId == id);
        allow list: if false;
        function validRole() {
          let s = getAfter(/databases/$(database)/documents/rooms/$(code)/secrets/current).data;
          return request.resource.data == {'roundId':s.roundId,'isSpy':id in spies(s),'location':id in spies(s) ? null : s.location};
        }
        allow create, update: if host(room(code)) && room(code).status == 'lobby' && after(code).status == 'active'
          && id in room(code).memberIds && validRole();
        allow delete: if clearingRound(code);
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
