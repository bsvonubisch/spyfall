{
  "name": "spyfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:emulators": "firebase emulators:exec --project demo-spyfall --only auth,firestore \"node --test tests/integration.test.js\"",
    "deploy": "npm run build && firebase deploy --project vu-spyfall --only hosting,firestore"
  },
  "dependencies": {"firebase": "^12.0.0", "qrcode": "^1.5.4"},
  "devDependencies": {"vite": "^6.0.0", "firebase-tools": "^14.0.0", "@firebase/rules-unit-testing": "^5.0.0"}
}
