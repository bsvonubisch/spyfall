{
  "name": "spyfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/unit/*.test.js",
    "test:emulators": "firebase emulators:exec --project demo-spyfall --only auth,firestore \"npm run test:integration\"",
    "deploy": "npm run build && firebase deploy --project vu-spyfall --only hosting,firestore",
    "test:integration": "node --test --test-force-exit --test-timeout=30000 tests/integration.test.js",
    "test:all": "npm test && npm run test:emulators"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "firebase-tools": "^14.0.0",
    "@firebase/rules-unit-testing": "^5.0.0"
  }
}
