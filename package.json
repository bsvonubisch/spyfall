{
  "name": "spyfall",
  "description": "A mobile social deduction game with private roles, live rooms, and per-player translations.",
  "homepage": "https://vu-spyfall.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/bsvonubisch/spyfall.git"
  },
  "bugs": {
    "url": "https://github.com/bsvonubisch/spyfall/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.js",
    "test:emulators": "firebase emulators:exec --project demo-spyfall --only auth,firestore \"npm run test:integration\"",
    "deploy": "npm run build && firebase deploy --project vu-spyfall --only hosting,firestore",
    "test:integration": "node --test --test-force-exit --test-timeout=30000 tests/integration.test.js",
    "test:all": "npm test && npm run test:emulators"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "firebase": "^12.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "axe-core": "^4.14.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^31.0.1",
    "prettier": "3.10.1",
    "vite": "^6.0.0"
  }
}
